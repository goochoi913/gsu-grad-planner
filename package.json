{
  "name": "gsu-grad-planner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Eunbee's degree planner for the GSU B.S. in Computer Science: academic timeline, Degree Works audit, GPA projection, and the Spring 2027 class schedule.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "tsx scripts/logic-test.ts",
    "test:flows": "node scripts/flow-test.mjs",
    "data:schedule": "node scripts/build-schedule.mjs",
    "data:rmp": "node scripts/fetch-rmp.mjs",
    "data": "node scripts/build-schedule.mjs && node scripts/fetch-rmp.mjs",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
